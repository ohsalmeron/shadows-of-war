#!/usr/bin/env bash
# Shadows of War — single entrypoint: ./sow cg | p | prod | ptr | l | local
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

if [[ -f "${ROOT}/.env" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "${ROOT}/.env"
  set +a
fi

# Own cargo output dir — never touch a root-owned workspace target/.
export CARGO_TARGET_DIR="${ROOT}/dist/.cargo-target"
mkdir -p "${CARGO_TARGET_DIR}"

BIN="${CARGO_TARGET_DIR}/release/sow"
needs_build=0
if [[ ! -x "${BIN}" ]]; then
  needs_build=1
elif find "${ROOT}/sow-dist/src" "${ROOT}/sow-dist/Cargo.toml" -newer "${BIN}" 2>/dev/null | grep -q .; then
  needs_build=1
fi
if [[ "${needs_build}" -eq 1 ]]; then
  echo "==> building sow..."
  cargo build -q -p sow-dist --release
fi
exec "${BIN}" "$@"
