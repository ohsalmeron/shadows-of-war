#!/usr/bin/env bash
# Shadows of War — single entrypoint & official developer launcher
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

show_help() {
  cat <<'EOF'
Shadows of War — Official Developer CLI & Launcher

USAGE:
  ./sow [COMMAND] [OPTIONS]

COMMANDS:
  (no args) / native   Run native desktop game client directly
  l, local              Build WASM + webroot and serve it locally on port 4173
  p, prod              Run full production build & deploy pipeline (WASM + Android + FreeBSD + Azure)
  help, -h, --help     Show this help message

EXAMPLES:
  ./sow                # Launch desktop game client
  ./sow l              # Build and serve the local web client (Ctrl-C to stop)
  ./sow p              # Full production build and deploy to IONOS & Azure
  ./sow p -v           # Production deploy with public + Android version bump
EOF
}

CMD="${1:-native}"

case "${CMD}" in
  -h|--help|help)
    show_help
    exit 0
    ;;
  native|n)
    export VERBOSE="${VERBOSE:-1}"
    export SOW_WS_URL="${SOW_WS_URL:-wss://shadowsofwar.io/ws/}"
    export SOW_MAPS_URL="${SOW_MAPS_URL:-https://shadowsofwar.io/maps}"
    export SOW_ASSETS_URL="${SOW_ASSETS_URL:-https://shadowsofwar.io/assets}"
    export SOW_DATABASE_URL="${SOW_DATABASE_URL:-https://shadowsofwar.io/api}"
    shift 2>/dev/null || true
    exec cargo run --bin client -- "$@"
    ;;
  l|local)
    if [[ -f "${ROOT}/sow-dist/.env" ]]; then
      set -a; source "${ROOT}/sow-dist/.env"; set +a
    fi
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
    mkdir -p "${CARGO_TARGET_DIR}"
    BIN="${CARGO_TARGET_DIR}/debug/sow"
    cargo build -p sow-dist
    exec "${BIN}" "$@"
    ;;
  p|prod|play)
    if [[ -f "${ROOT}/sow-dist/.env" ]]; then
      set -a; source "${ROOT}/sow-dist/.env"; set +a
    fi
    SOW_USER_HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
    SOW_RUBY_BIN="${SOW_USER_HOME}/.local/share/gem/ruby/3.4.0/bin"
    export PATH="${SOW_RUBY_BIN}:${PATH}"
    export SOW_PLAY_KEY="${SOW_PLAY_KEY:-${SOW_USER_HOME}/.config/shadows-of-war/google-play-service-account.json}"
    export FASTLANE_OPT_OUT_USAGE=1
    export FASTLANE_SKIP_UPDATE_CHECK=1
    export FASTLANE_DISABLE_COLORS=1
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
    mkdir -p "${CARGO_TARGET_DIR}"
    BIN="${CARGO_TARGET_DIR}/debug/sow"
    SOW_LOG_DIR="${ROOT}/dist/logs"
    SOW_LOG_FILE="${SOW_LOG_DIR}/prod-$(date +%Y%m%d-%H%M%S).log"
    mkdir -p "${SOW_LOG_DIR}"
    : >"${SOW_LOG_FILE}"
    chmod 600 "${SOW_LOG_FILE}"
    set +e
    (
      cargo build -p sow-dist || exit $?
      exec "${BIN}" "$@"
    ) 2>&1 | tee "${SOW_LOG_FILE}"
    SOW_STATUS=${PIPESTATUS[0]}
    set -e
    echo "Production log: ${SOW_LOG_FILE}"
    exit "${SOW_STATUS}"
    ;;
  *)
    echo "Unknown command: ${CMD}" >&2
    echo "" >&2
    show_help >&2
    exit 1
    ;;
esac
