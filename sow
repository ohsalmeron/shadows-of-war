#!/usr/bin/env bash
# Shadows of War — single entrypoint
#   ./sow       → run native client
#   ./sow l     → local web dev (WASM + serve :8787)
#   ./sow p     → full production deployment (web + server)
#   ./sow b     → build and deploy backfill to configured hosts
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

if [[ -f "${ROOT}/sow-dist/.env" ]]; then
  set -a; source "${ROOT}/sow-dist/.env"; set +a
fi

export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
mkdir -p "${CARGO_TARGET_DIR}"

BIN="${CARGO_TARGET_DIR}/debug/sow"
cargo build -p sow-dist
exec "${BIN}" "${@:-native}"
