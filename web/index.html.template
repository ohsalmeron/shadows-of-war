<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shadows of War - Epic Multiplayer Grand Strategy Game</title>
    <meta name="description" content="Command massive armies, conquer territories, and dominate your opponents in Shadows of War, an intense multiplayer grand strategy web game. Play instantly in your browser!">
    <meta name="keywords" content="strategy game, multiplayer strategy, io game, browser game, grand strategy, conquest, free to play">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://shadowsofwar.io/">
    <meta property="og:title" content="Shadows of War - Epic Multiplayer Grand Strategy Game">
    <meta property="og:description" content="Command massive armies, conquer territories, and dominate your opponents in Shadows of War, an intense multiplayer grand strategy web game. Play instantly in your browser!">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://shadowsofwar.io/">
    <meta property="twitter:title" content="Shadows of War - Epic Multiplayer Grand Strategy Game">
    <meta property="twitter:description" content="Command massive armies, conquer territories, and dominate your opponents in Shadows of War, an intense multiplayer grand strategy web game. Play instantly in your browser!">

    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="https://shadowsofwar.io/">
    <link rel="icon" href="./sow.svg" type="image/svg+xml">

    <!-- PORTAL_SDK_SLOT: CrazyGames SDK <script> is injected here only by ./scripts/sow.sh package. Website/PTR ship nothing. -->

    <link rel="modulepreload" href="./__JS_FILE__">
    <link rel="preload" href="./__WASM_FILE__" as="fetch" type="application/wasm" crossorigin="anonymous" fetchpriority="high">
    <link rel="preload" href="./assets/ui/sow-splash-desktop.webp?v=__BUILD_TS__" as="image" type="image/webp" media="(min-width: 600px)" fetchpriority="high">
    <link rel="preload" href="./assets/ui/sow-splash-mobile.webp?v=__BUILD_TS__" as="image" type="image/webp" media="(max-width: 599px)" fetchpriority="high">
    <link rel="preload" href="./assets/ui/loader_empty.webp?v=__BUILD_TS__" as="image" type="image/webp" fetchpriority="high">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #0a0a0f;
            overflow: hidden;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        #version {
            position: absolute;
            bottom: 10px;
            right: 10px;
            color: rgba(189, 189, 189, 0.71);
            font-size: 8px;
            pointer-events: none;
            z-index: 9999;
        }

        #web-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10000;
            background-color: #0a0a0f;
            overflow: hidden;
        }

        #web-loader .splash-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            pointer-events: none;
        }

        #web-loader .loader-bar-wrap {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
            overflow: visible;
        }

        #web-loader .loader-bar-wrap .loader-text {
            top: 50%;
            left: 50%;
            z-index: 2;
        }

        #web-loader .loader-bar-empty {
            display: block;
            width: 100%;
            height: 100%;
        }

        #web-loader .loader-bar-fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 0%;
            overflow: hidden;
            will-change: width;
        }

        #web-loader .loader-bar-full {
            display: block;
            height: 100%;
            width: auto;
            max-width: none;
        }

        #web-loader .loader-text {
            position: absolute;
            left: 50%;
            transform: translate(-50%, -50%);
            margin: 0;
            line-height: 1;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            font-size: 12px;
            font-weight: 600;
            color: #fff;
            text-shadow:
                0 2px 0 #000,
                0 4px 0 #000,
                -1.0px -1.0px 0 #000,
                1.0px -1.0px 0 #000,
                -1.0px 1.0px 0 #000,
                1.0px 1.0px 0 #000;
            white-space: nowrap;
            pointer-events: none;
        }

        /* Fallback sizes before JS layout(); JS sets data-layout + inline font-size. */
        @media (max-width: 599px) and (orientation: portrait) {
            #web-loader .loader-text {
                font-size: 12px;
            }
        }

        @media (max-width: 599px) and (orientation: landscape) {
            #web-loader .loader-text {
                font-size: 10px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            #web-loader {
                transition: none;
            }
        }
    </style>
</head>
<body>
    <div id="web-loader" aria-live="polite" aria-busy="true"></div>

    <div style="display: none;" aria-hidden="true">
        <h1>Shadows of War</h1>
        <p>Command massive armies, conquer territories, and dominate your opponents in Shadows of War, an intense multiplayer grand strategy web game. Play instantly in your browser without any downloads. Join thousands of players in real-time tactical warfare, expand your empire, and prove your strategic supremacy.</p>
    </div>
    <canvas id="blade" oncontextmenu="return false;"></canvas>
    <div id="version">v__VERSION__</div>

    <script src="./sdk/store_portals.js"></script>
    <script>/* __INLINE_LOADER_JS__ */</script>
    <script type="text/javascript">
        window.SOW_BUILD_TS = "__BUILD_TS__";
        /* PORTAL_BOOT_SLOT: SOW_PORTAL/SOW_WS_URL/SOW_MAPS_URL are injected here only by the CrazyGames package build. */
        (function () {
            var h = window.location.hostname;
            if (h === "appassets.androidplatform.net") {
                window.SOW_WS_URL = "wss://shadowsofwar.io/ws/";
                window.SOW_MAPS_URL = window.location.origin + "/assets/assets/maps";
            } else if (/crazygames\\.com$/i.test(h) || /dev-crazygames\\.com$/i.test(h)) {
                window.SOW_PORTAL = window.SOW_PORTAL || "crazygames";
                window.SOW_WS_URL = window.SOW_WS_URL || "wss://shadowsofwar.io/ws/";
                window.SOW_MAPS_URL = window.SOW_MAPS_URL || (window.location.origin + "/assets/maps");
            }
        })();
    </script>
    <script type="module">
        async function run() {
            var isPortal = window.SOW_PORTAL === "crazygames"
                || /crazygames\\.com$/i.test(window.location.hostname)
                || /dev-crazygames\\.com$/i.test(window.location.hostname);

            if (typeof window.SOW_initPortalSdk === "function") {
                await window.SOW_initPortalSdk();
            }

            if ('serviceWorker' in navigator
                && window.location.hostname !== "appassets.androidplatform.net"
                && !isPortal) {
                navigator.serviceWorker.register('./sw.js', { scope: './' }).catch(function (err) {
                    console.warn('Service worker registration failed:', err);
                });
            }

            try {
                const { default: init } = await import('./__JS_FILE__');
                await init({ module_or_path: './__WASM_FILE__' });
            } catch (e) {
                if (e.message !== "Using exceptions for control flow, don't mind me. This isn't actually an error!") {
                    throw e;
                }
            }
        }

        run();
    </script>
</body>
</html>
