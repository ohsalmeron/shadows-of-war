#!/usr/bin/env bash
# Android release APK via cargo-apk. Output: ./target/aarch64-linux-android/release/apk/*.apk
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

die() { echo "build_android: $*" >&2; exit 1; }

MANIFEST=""
for tom in "${ROOT}/sow-android/Cargo.toml"; do
  [[ -f "$tom" ]] && grep -q '^\[package.metadata.android\]' "$tom" 2>/dev/null && MANIFEST="$tom" && break
done
[[ -n "$MANIFEST" ]] || die "no sow-android/ with [package.metadata.android] — add that crate first."

if [[ -z "${ANDROID_HOME:-}" && -z "${ANDROID_SDK_ROOT:-}" ]]; then
  [[ -d "$HOME/Android/Sdk/platform-tools" ]] && export ANDROID_HOME="$HOME/Android/Sdk"
fi
if [[ -z "${ANDROID_NDK_HOME:-}" && -z "${NDK_HOME:-}" && -n "${ANDROID_HOME:-}" && -d "$ANDROID_HOME/ndk" ]]; then
  export ANDROID_NDK_HOME="$(find "$ANDROID_HOME/ndk" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -V | tail -1)"
fi
[[ -n "${ANDROID_HOME:-}" || -n "${ANDROID_SDK_ROOT:-}" ]] || die "set ANDROID_HOME (e.g. export ANDROID_HOME=\$HOME/Android/Sdk)"
[[ -n "${ANDROID_NDK_HOME:-}" || -n "${NDK_HOME:-}" ]] || die "set ANDROID_NDK_HOME or install NDK under \$ANDROID_HOME/ndk"

command -v cargo >/dev/null || die "cargo not found"
rustup target list --installed 2>/dev/null | grep -qx aarch64-linux-android || die "run: rustup target add aarch64-linux-android"
(cargo apk --version >/dev/null 2>&1 || cargo-apk --version >/dev/null 2>&1) || die "run: cargo install cargo-apk"

echo "Building release APK (manifest: $MANIFEST)"
cargo apk build --release --manifest-path "$MANIFEST"
echo ""
echo "APKs are under: ${ROOT}/target/aarch64-linux-android/release/apk/"
