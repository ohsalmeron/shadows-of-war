---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { 
  title, 
  description = "Free, open-source MMORTS on world maps. Lead civilizations, forge alliances, expand territory, and grow your economy.",
  activeNav = "" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050508" />
    <title>{title}</title>
    <link rel="icon" href="/sow.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/assets/cdn/ui/sow-splash-desktop.webp" type="image/webp" media="(min-width:481px)" fetchpriority="high" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <header class="site-header">
      <a href="/" class="brand">
        <svg viewBox="0 0 100 100" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="width: 24px; height: 24px; vertical-align: middle; margin-right: 8px;">
          <path d="M50 5 L90 25 L90 75 L50 95 L10 75 L10 25 Z" fill="none" stroke="currentColor" stroke-width="8"/>
          <path d="M50 15 L80 30 L80 70 L50 85 L20 70 L20 30 Z" fill="currentColor" opacity="0.3"/>
          <circle cx="50" cy="50" r="12" fill="currentColor"/>
        </svg>
        <span>Shadows of War</span>
      </a>
      <nav>
        <a href="/wiki" class={activeNav === 'wiki' ? 'active' : ''}>Wiki</a>
      </nav>
    </header>

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__left">
        &copy; Shadows of War &bull; Based on <a href="https://openfront.io" target="_blank" rel="noopener">OpenFront</a> (AGPL-3.0)
      </div>
      <div class="site-footer__right">
        <a href="/terms">Terms</a>
        <span class="footer-dot">&bull;</span>
        <a href="/privacy">Privacy</a>
        <span class="footer-dot">&bull;</span>
        <a href="https://discord.gg/eauHRf7zP" target="_blank" rel="noopener">Discord</a>
        <span class="footer-dot">&bull;</span>
        <a href="https://github.com/ohsalmeron/shadows-of-war" target="_blank" rel="noopener">GitHub</a>
      </div>
    </footer>

    <div id="game-overlay" class="game-overlay" hidden>
      <button type="button" id="game-restore-btn" class="game-restore-btn" aria-label="Back to site">Back to site</button>
      <iframe id="sow-game-frame-mobile" title="Shadows of War" allow="fullscreen"></iframe>
    </div>

    <script>
      let PLAY_URL = (window as any).SOW_PLAY_URL;
      if (!PLAY_URL) {
        const host = window.location.hostname;
        if (host === '127.0.0.1' || host === 'localhost') {
          PLAY_URL = '/game/index.html';
        } else {
          PLAY_URL = 'https://play.shadowsofwar.io/';
        }
      }

      let mobileLoaded = false;

      function enterGame() {
        const isMobile = window.matchMedia('(max-width: 480px)').matches;
        if (isMobile) {
          const overlay = document.getElementById('game-overlay');
          const mobileFrame = document.getElementById('sow-game-frame-mobile') as HTMLIFrameElement;
          if (!overlay || !mobileFrame) return;

          if (!mobileLoaded) {
            mobileFrame.src = PLAY_URL;
            mobileLoaded = true;
          }
          overlay.hidden = false;
          document.body.classList.add('game-active');
        } else {
          if (window.location.pathname !== '/' && window.location.pathname !== '/index.html') {
            window.location.href = '/#play';
          } else {
            const stage = document.getElementById('sow-game-stage');
            const desktopFrame = document.getElementById('sow-game-frame') as HTMLIFrameElement;
            if (stage && desktopFrame) {
              const current = desktopFrame.getAttribute('src');
              if (!current || current === 'about:blank') {
                desktopFrame.src = PLAY_URL;
              }
              stage.classList.add('playing');
            }
          }
        }
      }

      function restoreSite() {
        const overlay = document.getElementById('game-overlay');
        const mobileFrame = document.getElementById('sow-game-frame-mobile') as HTMLIFrameElement;
        if (overlay) overlay.hidden = true;
        document.body.classList.remove('game-active');
        if (mobileFrame) {
          mobileFrame.src = 'about:blank';
          mobileLoaded = false;
        }
      }



      const restore = document.getElementById('game-restore-btn');
      if (restore) {
        restore.addEventListener('click', restoreSite);
      }

      (window as any).SOW_enterGame = enterGame;
      (window as any).SOW_restoreSite = restoreSite;
    </script>
  </body>
</html>
