---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shadows of War — Free Open-Source MMORTS Strategy Game">
  <div class="portal-page">
    <header class="hero-header">
      <div class="title-glow-wrap">
        <h1 class="portal-title">SHADOWS OF WAR</h1>
        <div class="glow-effect"></div>
      </div>
      <p class="portal-subtitle">Lead civilizations, expand territory, forge alliances, and grow your economy on massive world maps.</p>
    </header>

    <!-- Interactive Game Stage Container -->
    <div id="game-stage" class="sow-stage">
      <!-- Cover Splash Overlay -->
      <div class="hero-cover">
        <div class="hero-cover__bg"></div>
        <div class="hero-cover__inner">
          <div class="tactical-bracket">
            <button id="start-game-btn" class="play-btn play-btn--hero">⚔️ Play in Browser</button>
          </div>
        </div>
      </div>

      <!-- Embedded Game Iframe -->
      <iframe 
        id="sow-game-frame" 
        class="sow-stage__frame" 
        src="about:blank" 
        allow="autoplay; gamepad; fullscreen; keyboard"
        allowfullscreen
      ></iframe>

      <!-- Control Bar overlays the active game (visible on hover or focus) -->
      <div id="game-control-bar" class="game-controls" style="display: none;">
        <button id="fs-toggle-btn" class="control-btn" title="Toggle Fullscreen">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="vertical-align: middle;">
            <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
          </svg>
          <span>Fullscreen</span>
        </button>
        <a href="/play/" class="control-btn control-btn--tab" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="vertical-align: middle;">
            <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41 9.83-9.83V9h2V3h-7z"/>
          </svg>
          <span>Full Tab</span>
        </a>
      </div>
    </div>
  </div>

  <script>
    const stage = document.getElementById('game-stage');
    const iframe = document.getElementById('sow-game-frame') as HTMLIFrameElement;
    const startBtn = document.getElementById('start-game-btn');
    const controlBar = document.getElementById('game-control-bar');
    const fsBtn = document.getElementById('fs-toggle-btn');

    if (startBtn && iframe && stage && controlBar) {
      startBtn.addEventListener('click', () => {
        // Load the actual play page when clicked (prevents initial heavy WASM load on home visit)
        iframe.src = '/play/';
        stage.classList.add('playing');
        controlBar.style.display = 'flex';
      });
    }

    if (fsBtn && stage) {
      fsBtn.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          stage.requestFullscreen().catch((err) => {
            console.error(`Error attempting to enable fullscreen: ${err.message}`);
          });
        } else {
          document.exitFullscreen();
        }
      });

      // Update button text / state on fullscreen change
      document.addEventListener('fullscreenchange', () => {
        if (document.fullscreenElement === stage) {
          fsBtn.innerHTML = `
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="vertical-align: middle; margin-right: 4px;">
              <path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/>
            </svg>
            <span>Exit Fullscreen</span>
          `;
          stage.classList.add('is-fullscreen');
        } else {
          fsBtn.innerHTML = `
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="vertical-align: middle; margin-right: 4px;">
              <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
            </svg>
            <span>Fullscreen</span>
          `;
          stage.classList.remove('is-fullscreen');
        }
      });
    }
  </script>

  <style>
    .portal-page {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 30px;
      width: 100%;
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .hero-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-align: center;
    }

    .title-glow-wrap {
      position: relative;
      display: inline-block;
    }

    .portal-title {
      font-family: var(--font-display);
      font-size: 38px;
      font-weight: 800;
      letter-spacing: 3px;
      background: linear-gradient(to bottom, #ffffff 40%, #94a3b8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
    }

    .glow-effect {
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      height: 40px;
      background: radial-gradient(circle, var(--border-glow) 0%, rgba(0, 0, 0, 0) 70%);
      filter: blur(15px);
      z-index: -1;
      pointer-events: none;
    }

    .portal-subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      max-width: 500px;
      line-height: 1.5;
    }

    /* Embedded stage controls */
    .game-controls {
      position: absolute;
      bottom: 12px;
      right: 12px;
      display: flex;
      gap: 8px;
      z-index: 10;
      opacity: 0.2;
      transition: opacity 0.25s ease;
    }

    .sow-stage:hover .game-controls,
    .sow-stage.is-fullscreen .game-controls,
    .game-controls:focus-within {
      opacity: 1;
    }

    .control-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: rgba(5, 5, 8, 0.85);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      color: #fff;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .control-btn:hover {
      background: var(--accent-glow);
      border-color: var(--accent-color);
      color: #fff;
      box-shadow: 0 0 10px rgba(196, 162, 101, 0.3);
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      .portal-title {
        font-size: 28px;
      }
      .portal-page {
        padding: 10px;
        gap: 20px;
      }
    }
  </style>
</Layout>
