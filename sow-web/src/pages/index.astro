---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shadows of War — Web Portal">
  <div class="container">
    <header class="hero-header">
      <div class="title-glow-wrap">
        <h1 class="portal-title">SHADOWS OF WAR</h1>
        <div class="glow-effect"></div>
      </div>
      <p class="portal-subtitle">Lead civilizations, expand territory, and defeat enemies on massive world maps.</p>
      <a href="/play/" class="play-btn play-btn--hero">⚔️ Play Now</a>
    </header>
  </div>

  <style>
    .container {
      max-width: 700px;
      margin: auto;
      padding: 40px 20px;
      text-align: center;
    }

    .hero-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }

    .title-glow-wrap {
      position: relative;
      display: inline-block;
    }

    .portal-title {
      font-family: var(--font-display);
      font-size: 48px;
      font-weight: 800;
      letter-spacing: 3px;
      background: linear-gradient(to bottom, #ffffff 40%, #94a3b8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
    }

    .glow-effect {
      position: absolute;
      top: -20px;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      height: 60px;
      background: radial-gradient(circle, var(--border-glow) 0%, rgba(0, 0, 0, 0) 70%);
      filter: blur(20px);
      z-index: -1;
      pointer-events: none;
    }

    .portal-subtitle {
      font-size: 16px;
      color: var(--text-secondary);
      max-width: 500px;
      line-height: 1.5;
    }
  </style>
</Layout>
