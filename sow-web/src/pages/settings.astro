---
import ShellLayout from '../layouts/ShellLayout.astro';
---

<ShellLayout title="Settings — Shadows of War">
  <div class="container">
    <div class="glass-panel card settings-card">
      <h2 class="section-title">SYSTEM SETTINGS</h2>
      
      <div class="settings-grid">
        <!-- Audio Settings -->
        <div class="settings-section">
          <h3 class="subsection-title">🔊 Audio Controls</h3>
          
          <div class="form-group">
            <div class="checkbox-wrapper">
              <input type="checkbox" id="mute_all" class="checkbox-premium" />
              <label for="mute_all">Mute All Sounds</label>
            </div>
          </div>

          <div class="form-group">
            <div class="slider-header">
              <label for="music_volume">Music Volume</label>
              <span id="music_volume_val">50%</span>
            </div>
            <input type="range" id="music_volume" min="0" max="1" step="0.05" class="slider-premium" />
          </div>

          <div class="form-group">
            <div class="slider-header">
              <label for="sfx_volume">SFX Volume</label>
              <span id="sfx_volume_val">70%</span>
            </div>
            <input type="range" id="sfx_volume" min="0" max="1" step="0.05" class="slider-premium" />
          </div>
        </div>

        <!-- Gameplay Settings -->
        <div class="settings-section">
          <h3 class="subsection-title">🎮 Gameplay Options</h3>

          <div class="form-group">
            <label for="language">Language</label>
            <select id="language" class="input-premium select-premium">
              <option value="English">English</option>
              <option value="Spanish">Español</option>
              <option value="French">Français</option>
              <option value="German">Deutsch</option>
              <option value="Russian">Русский</option>
              <option value="Chinese">中文</option>
            </select>
          </div>

          <div class="form-group">
            <div class="checkbox-wrapper">
              <input type="checkbox" id="show_fps_ping" class="checkbox-premium" />
              <label for="show_fps_ping">Display Performance Stats (FPS / Ping)</label>
            </div>
          </div>

          <div class="form-group">
            <div class="checkbox-wrapper">
              <input type="checkbox" id="reduced_motion" class="checkbox-premium" />
              <label for="reduced_motion">Reduced Motion (Skip non-essential animations)</label>
            </div>
          </div>

          <div class="form-group">
            <div class="checkbox-wrapper">
              <input type="checkbox" id="custom_theme" class="checkbox-premium" />
              <label for="custom_theme">Enable Custom Portal UI Theme</label>
            </div>
          </div>
        </div>
      </div>

      <div class="actions-footer">
        <button id="btn-save" class="btn-premium">💾 SAVE CONFIGURATION</button>
      </div>
    </div>
  </div>

  <style>
    .container {
      max-width: 800px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .settings-card {
      border: 1px solid var(--border-muted);
    }

    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: var(--text-primary);
      margin-bottom: 24px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border-muted);
      text-transform: uppercase;
    }

    .settings-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    @media (max-width: 700px) {
      .settings-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
    }

    .settings-section {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .subsection-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 10px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .slider-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .slider-header span {
      font-size: 12px;
      font-weight: 700;
      color: var(--primary);
    }

    .slider-premium {
      -webkit-appearance: none;
      width: 100%;
      height: 6px;
      background: var(--border-muted);
      border-radius: 3px;
      outline: none;
      transition: background 0.3s;
    }

    .slider-premium::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--primary);
      box-shadow: 0 0 10px var(--primary-glow);
      cursor: pointer;
      transition: transform 0.2s;
    }

    .slider-premium::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }

    .checkbox-wrapper {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
    }

    .checkbox-wrapper label {
      cursor: pointer;
      text-transform: none;
      font-weight: 500;
      color: var(--text-primary);
      user-select: none;
    }

    .checkbox-premium {
      appearance: none;
      width: 18px;
      height: 18px;
      border: 1px solid var(--border-muted);
      border-radius: 4px;
      background: rgba(3, 3, 7, 0.6);
      cursor: pointer;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s;
    }

    .checkbox-premium:checked {
      background: var(--primary);
      border-color: var(--primary);
      box-shadow: 0 0 8px var(--primary-glow);
    }

    .checkbox-premium:checked::after {
      content: '✓';
      color: white;
      font-size: 11px;
      font-weight: 800;
    }

    .select-premium {
      cursor: pointer;
    }

    .select-premium option {
      background: var(--bg-surface);
      color: var(--text-primary);
    }

    .actions-footer {
      margin-top: 32px;
      padding-top: 20px;
      border-top: 1px solid var(--border-muted);
      display: flex;
      justify-content: flex-end;
    }
  </style>

  <script>
    // Retrieve configurations
    let config = {
      music_volume: 0.5,
      sfx_volume: 0.7,
      mute_all: false,
      language: 'English',
      reduced_motion: false,
      show_fps_ping: true,
      custom_theme: false
    };

    try {
      const stored = localStorage.getItem('SOW_SETTINGS_JSON');
      if (stored) {
        config = { ...config, ...JSON.parse(stored) };
      }
    } catch (e) {}

    // Populate UI fields
    const muteEl = document.getElementById('mute_all') as HTMLInputElement;
    const musicEl = document.getElementById('music_volume') as HTMLInputElement;
    const sfxEl = document.getElementById('sfx_volume') as HTMLInputElement;
    const langEl = document.getElementById('language') as HTMLSelectElement;
    const fpsEl = document.getElementById('show_fps_ping') as HTMLInputElement;
    const motionEl = document.getElementById('reduced_motion') as HTMLInputElement;
    const themeEl = document.getElementById('custom_theme') as HTMLInputElement;

    const musicValEl = document.getElementById('music_volume_val');
    const sfxValEl = document.getElementById('sfx_volume_val');

    if (muteEl) muteEl.checked = config.mute_all;
    if (musicEl) {
      musicEl.value = String(config.music_volume);
      if (musicValEl) musicValEl.innerText = Math.round(config.music_volume * 100) + '%';
      musicEl.addEventListener('input', () => {
        if (musicValEl) musicValEl.innerText = Math.round(Number(musicEl.value) * 100) + '%';
      });
    }
    if (sfxEl) {
      sfxEl.value = String(config.sfx_volume);
      if (sfxValEl) sfxValEl.innerText = Math.round(config.sfx_volume * 100) + '%';
      sfxEl.addEventListener('input', () => {
        if (sfxValEl) sfxValEl.innerText = Math.round(Number(sfxEl.value) * 100) + '%';
      });
    }
    if (langEl) langEl.value = config.language;
    if (fpsEl) fpsEl.checked = config.show_fps_ping;
    if (motionEl) motionEl.checked = config.reduced_motion;
    if (themeEl) themeEl.checked = config.custom_theme;

    // Save configurations
    document.getElementById('btn-save')?.addEventListener('click', () => {
      const current = {
        music_volume: Number(musicEl.value),
        sfx_volume: Number(sfxEl.value),
        mute_all: muteEl.checked,
        language: langEl.value,
        reduced_motion: motionEl.checked,
        show_fps_ping: fpsEl.checked,
        custom_theme: themeEl.checked
      };
      
      localStorage.setItem('SOW_SETTINGS_JSON', JSON.stringify(current));
      
      // Visual feedback
      const btn = document.getElementById('btn-save');
      if (btn) {
        const originalText = btn.innerText;
        btn.innerText = '✓ CONFIGURATION SAVED!';
        // @ts-ignore
        btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
        setTimeout(() => {
          btn.innerText = originalText;
          // @ts-ignore
          btn.style.background = '';
        }, 1500);
      }
    });
  </script>
</ShellLayout>
