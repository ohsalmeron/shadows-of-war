---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Parse the simple TOML file statically at build time
function parseSimpleToml(content: string) {
  const result: any = { sections: [] };
  let currentSection: any = null;
  let inArray = false;
  let arrayKey: string | null = null;
  let arrayLines: string[] = [];

  const lines = content.split('\n');
  for (let line of lines) {
    line = line.trim();
    if (!line || line.startsWith('#')) continue;

    if (inArray) {
      if (line.endsWith(']')) {
        inArray = false;
        const itemLine = line.substring(0, line.length - 1).trim();
        if (itemLine) {
          arrayLines.push(itemLine);
        }
        const text = arrayLines.join(' ');
        const items = text.split(/",\s*"/).map(s => {
          let cleaned = s.trim();
          if (cleaned.startsWith('"')) cleaned = cleaned.substring(1);
          if (cleaned.endsWith('"')) cleaned = cleaned.substring(0, cleaned.length - 1);
          return cleaned.replace(/\\"/g, '"');
        }).filter(Boolean);

        if (currentSection) {
          if (arrayKey === 'paragraphs') {
            currentSection.paragraphs = items;
          } else if (arrayKey === 'bullets') {
            currentSection.bullets = items;
          }
        }
        arrayLines = [];
        arrayKey = null;
      } else {
        arrayLines.push(line);
      }
      continue;
    }

    if (line === '[[sections]]') {
      currentSection = { heading: '', paragraphs: [], bullets: [], links: [] };
      result.sections.push(currentSection);
      continue;
    }

    if (line === '[[sections.links]]') {
      if (currentSection) {
        currentSection.links.push({ label: '', url: '' });
      }
      continue;
    }

    const eqIdx = line.indexOf('=');
    if (eqIdx !== -1) {
      const key = line.substring(0, eqIdx).trim();
      let val: any = line.substring(eqIdx + 1).trim();

      if (val.startsWith('[') && !val.endsWith(']')) {
        inArray = true;
        arrayKey = key;
        const rest = val.substring(1).trim();
        if (rest) arrayLines.push(rest);
        continue;
      }

      if (val.startsWith('"') && val.endsWith('"')) {
        val = val.substring(1, val.length - 1);
      } else if (val.startsWith('[') && val.endsWith(']')) {
        const inner = val.substring(1, val.length - 1).trim();
        const items = inner.split(/",\s*"/).map(s => {
          let cleaned = s.trim();
          if (cleaned.startsWith('"')) cleaned = cleaned.substring(1);
          if (cleaned.endsWith('"')) cleaned = cleaned.substring(0, cleaned.length - 1);
          return cleaned.replace(/\\"/g, '"');
        }).filter(Boolean);
        val = items;
      }

      if (key === 'title') {
        result.title = val;
      } else if (key === 'updated') {
        result.updated = val;
      } else if (currentSection) {
        if (key === 'heading') {
          currentSection.heading = val;
        } else if (key === 'paragraphs') {
          currentSection.paragraphs = Array.isArray(val) ? val : [val];
        } else if (key === 'bullets') {
          currentSection.bullets = Array.isArray(val) ? val : [val];
        } else if (key === 'label' || key === 'url') {
          const link = currentSection.links[currentSection.links.length - 1];
          if (link) {
            link[key] = val;
          }
        }
      }
    }
  }
  return result;
}

// Read and parse file
const filePath = path.join(process.cwd(), 'public', 'legal', 'terms.en.toml');
const rawContent = fs.readFileSync(filePath, 'utf-8');
const doc = parseSimpleToml(rawContent);
---

<Layout title={doc.title}>
  <div class="content-wrapper">
    <h1>{doc.title}</h1>
    <p class="meta-date">{doc.updated}</p>

    {doc.sections.map((section: any) => (
      <section style="margin-bottom: 2rem;">
        <h2>{section.heading}</h2>
        
        {section.paragraphs && section.paragraphs.map((p: string) => (
          <p>{p}</p>
        ))}

        {section.bullets && section.bullets.length > 0 && (
          <ul>
            {section.bullets.map((b: string) => (
              <li>{b}</li>
            ))}
          </ul>
        )}

        {section.links && section.links.map((link: any) => (
          <p>
            <a href={link.url}>{link.label}</a>
          </p>
        ))}
      </section>
    ))}

    <a href="/" class="back-link">
      <svg style="width: 16px; height: 16px; vertical-align: middle;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to Home
    </a>
  </div>
</Layout>
