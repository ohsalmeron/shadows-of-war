<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Shadows of War — Free Open-Source MMORTS Strategy Game</title>
    <meta name="description" content="Free, open-source MMORTS on world maps. Play solo offline or join online multiplayer: lead civilizations, forge alliances, expand territory, and grow your economy in massive real-time strategy battles.">
    <meta name="keywords" content="MMORTS, free to play, open source game, multiplayer real-time strategy, world maps, civilizations, alliances, territorial expansion, economy, strategy game, Shadows of War">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://shadowsofwar.io/play/">
    <meta property="og:title" content="Shadows of War — Free Open-Source MMORTS Strategy Game">
    <meta property="og:description" content="Free, open-source MMORTS on world maps. Lead civilizations, forge alliances, expand territory, and grow your economy in massive online real-time battles. Play Shadows of War.">
    <meta property="og:image" content="https://shadowsofwar.io/assets/cdn/ui/sow-splash-desktop.webp">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://shadowsofwar.io/play/">
    <meta property="twitter:title" content="Shadows of War — Free Open-Source MMORTS Strategy Game">
    <meta property="twitter:description" content="Free, open-source MMORTS on world maps. Lead civilizations, forge alliances, expand territory, and grow your economy in massive online real-time battles. Play Shadows of War.">
    <meta property="twitter:image" content="https://shadowsofwar.io/assets/cdn/ui/sow-splash-desktop.webp">

    <meta name="application-name" content="Shadows of War">
    <meta property="og:site_name" content="Shadows of War">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="https://shadowsofwar.io/play/">
    <link rel="icon" href="./sow.svg" type="image/svg+xml">

    <!-- PORTAL_SDK_SLOT: CrazyGames SDK <script> injected by sow-dist crazygames only. -->

    <link rel="modulepreload" href="./__JS_FILE__">
    <link rel="preload" href="./__WASM_FILE__" as="fetch" type="application/wasm" crossorigin="anonymous" fetchpriority="high">
    <link rel="preload" href="__ASSETS_UI_BASE__sow-splash-desktop.webp?v=__BUILD_TS__" as="image" type="image/webp" media="(min-width: 600px)" fetchpriority="high">
    <link rel="preload" href="__ASSETS_UI_BASE__sow-splash-mobile.webp?v=__BUILD_TS__" as="image" type="image/webp" media="(max-width: 599px)" fetchpriority="high">
    <link rel="preload" href="__ASSETS_UI_BASE__loader_empty.webp?v=__BUILD_TS__" as="image" type="image/webp" fetchpriority="high">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #0a0a0f;
            overflow: hidden;
        }
        :root {
            --sow-sat: env(safe-area-inset-top, 0px);
            --sow-sab: env(safe-area-inset-bottom, 0px);
            --sow-sal: env(safe-area-inset-left, 0px);
            --sow-sar: env(safe-area-inset-right, 0px);
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
            background-color: #0a0a0f;
            touch-action: none;
            overscroll-behavior: none;
        }
        #version {
            position: absolute;
            bottom: 8px;
            right: 8px;
            color: rgba(55, 255, 0, 0.2);
            font-size: 4px;
            pointer-events: none;
            z-index: 9999;
        }

        #web-loader {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            min-height: 100dvh;
            z-index: 10000;
            background-color: #0a0a0f;
            overflow: hidden;
        }

        #web-loader .splash-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            pointer-events: none;
        }

        #web-loader .loader-bar-wrap {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
            overflow: visible;
        }

        #web-loader .loader-bar-wrap .loader-text {
            top: calc(50% + 2px);
            left: 50%;
            z-index: 2;
        }

        #web-loader .loader-bar-empty {
            display: block;
            width: 100%;
            height: 100%;
        }

        #web-loader .loader-bar-fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 0%;
            overflow: hidden;
            will-change: width;
        }

        #web-loader .loader-bar-full {
            display: block;
            height: 100%;
            width: auto;
            max-width: none;
        }

        #web-loader .loader-text {
            position: absolute;
            left: 50%;
            transform: translate(-50%, -50%);
            margin: 0;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            font-size: 10px;
            font-weight: 600;
            color: #fff;
            text-shadow:
                0 2px 0 #000,
                -1px -1px 0 #000,
                1px -1px 0 #000,
                -1px 1px 0 #000,
                1px 1px 0 #000;
            white-space: nowrap;
            pointer-events: none;
        }

        /* Fallback sizes before JS layout(); JS sets data-layout + inline font-size. */
        @media (max-width: 599px) and (orientation: portrait) {
            #web-loader .loader-text {
                font-size: 12px;
            }
        }

        @media (max-width: 599px) and (orientation: landscape) {
            #web-loader .loader-text {
                font-size: 10px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            #web-loader {
                transition: none;
            }
        }
    </style>
</head>
<body>
    <div id="web-loader" aria-live="polite" aria-busy="true"></div>

    <!-- Portal store listings (Poki, CrazyGames, etc.) may scrape index.html for title/description. -->
    <div style="display: none;" aria-hidden="true">
        <h1>Shadows of War</h1>
        <p>Shadows of War is a free, open-source MMORTS strategy game on world maps. Play solo offline or join online multiplayer lobbies: lead civilizations, forge alliances, expand territory, and grow your economy in massive real-time battles. Free to play on CrazyGames, Poki, and shadowsofwar.io.</p>
    </div>
    <canvas id="blade" oncontextmenu="return false;" tabindex="0"></canvas>
    <div id="version">v__VERSION__</div>

    <script type="text/javascript">
        window.SOW_BUILD_TS = "__BUILD_TS__";
        window.SOW_BUILD_VERSION = "__VERSION__";
        /* Streamed maps/assets from prod nginx /maps and /assets (single source of truth). */
        window.SOW_MAPS_URL = window.SOW_MAPS_URL || "https://shadowsofwar.io/maps";
        window.SOW_ASSETS_URL = window.SOW_ASSETS_URL || "https://shadowsofwar.io/assets";
        window.SOW_DATABASE_URL = window.SOW_DATABASE_URL || "https://shadowsofwar.io/api";
        /* PORTAL_BOOT_SLOT: SOW_PORTAL / SOW_WS_URL overrides injected by sow-dist crazygames. */
        (function () {
            var h = window.location.hostname;
            var ref = document.referrer || "";
            if (h === "appassets.androidplatform.net") {
                window.SOW_WS_URL = "wss://shadowsofwar.io/ws/";
            } else if (/crazygames\\.com$/i.test(h) || /dev-crazygames\\.com$/i.test(h)) {
                window.SOW_PORTAL = window.SOW_PORTAL || "crazygames";
                window.SOW_WS_URL = window.SOW_WS_URL || "wss://shadowsofwar.io/ws/";
            } else if (/poki\\.com$/i.test(h) || /poki-gdn\\.com$/i.test(h) || /poki\\.io$/i.test(h)
                || /poki\\.com/i.test(ref) || /poki-gdn\\.com/i.test(ref)) {
                window.SOW_PORTAL = window.SOW_PORTAL || "poki";
                window.SOW_WS_URL = window.SOW_WS_URL || "wss://shadowsofwar.io/ws/";
            } else if (h === "play.shadowsofwar.io") {
                window.SOW_WS_URL = window.SOW_WS_URL || "wss://shadowsofwar.io/ws/";
                window.SOW_DATABASE_URL = "/api";
            } else if (h === "ptr.shadowsofwar.io") {
                window.SOW_WS_URL = window.SOW_WS_URL || "wss://ptr.shadowsofwar.io/ws/";
                window.SOW_DATABASE_URL = "/api";
            } else if (window.self !== window.top) {
                window.SOW_PORTAL = window.SOW_PORTAL || "site";
            }
        })();

    </script>
    <script src="./sdk/store_portals.js"></script>
    <script>/* __INLINE_LOADER_JS__ */</script>
    <script type="module">
        async function run() {
            var isPortal = window.SOW_RUNTIME && window.SOW_RUNTIME.portal_embed === true
                || window.SOW_isPortalEmbed === true;

            if (typeof window.SOW_initPortalSdk === "function") {
                await window.SOW_initPortalSdk();
            }
            if (typeof window.SOW_portalLoadStart === "function") {
                window.SOW_portalLoadStart();
            }

            if ('serviceWorker' in navigator
                && window.location.hostname !== "appassets.androidplatform.net"
                && !isPortal) {
                navigator.serviceWorker.register('./sw.js', { scope: './' }).catch(function (err) {
                    console.warn('Service worker registration failed:', err);
                });
            }

            try {
                const { default: init } = await import('./__JS_FILE__');
                await init({ module_or_path: './__WASM_FILE__' });
            } catch (e) {
                if (e.message !== "Using exceptions for control flow, don't mind me. This isn't actually an error!") {
                    throw e;
                }
            }
        }

        run();
    </script>
</body>
</html>
