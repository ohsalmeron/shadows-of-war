<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Play Shadows of War — MMORTS Strategy Game</title>
    <meta name="description" content="Enter Shadows of War, a match-based MMORTS. Choose a historical leader, expand territory, build your economy, and fight for control of the map.">
    <meta name="keywords" content="MMORTS, RTS, multiplayer strategy, territory conquest, grand strategy, Shadows of War">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://shadowsofwar.io/play/">
    <meta property="og:title" content="Play Shadows of War — MMORTS Strategy Game">
    <meta property="og:description" content="Enter Shadows of War, a match-based MMORTS. Choose a historical leader, expand territory, build your economy, and fight for control of the map.">
    <meta property="og:image" content="https://shadowsofwar.io/assets/shell/loader/sow-splash-desktop.webp">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://shadowsofwar.io/play/">
    <meta property="twitter:title" content="Play Shadows of War — MMORTS Strategy Game">
    <meta property="twitter:description" content="Enter Shadows of War, a match-based MMORTS. Choose a historical leader, expand territory, build your economy, and fight for control of the map.">
    <meta property="twitter:image" content="https://shadowsofwar.io/assets/shell/loader/sow-splash-desktop.webp">

    <meta name="application-name" content="Shadows of War">
    <meta property="og:site_name" content="Shadows of War">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="https://shadowsofwar.io/play/">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="./sow.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/fonts/fonts.css">

    <!-- PORTAL_SDK_SLOT: CrazyGames SDK <script> injected by sow-dist crazygames only. -->

    <link rel="modulepreload" href="./__JS_FILE__">
    <link rel="preload" href="./__WASM_FILE__" as="fetch" type="application/wasm" crossorigin="anonymous" fetchpriority="high">
    <link rel="preload" href="__ASSETS_UI_BASE__loader_empty.webp?v=__BUILD_TS__" as="image" type="image/webp" fetchpriority="high">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #0a0a0f;
            overflow: hidden;
        }
        :root {
            --sow-sat: env(safe-area-inset-top, 0px);
            --sow-sab: env(safe-area-inset-bottom, 0px);
            --sow-sal: env(safe-area-inset-left, 0px);
            --sow-sar: env(safe-area-inset-right, 0px);
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
            background-color: #0a0a0f;
            touch-action: none;
            overscroll-behavior: none;
        }
        #version {
            position: absolute;
            bottom: 8px;
            right: 8px;
            color: rgba(55, 255, 0, 0.2);
            font-size: 4px;
            pointer-events: none;
            z-index: 9999;
        }

        #web-loader {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            min-height: 100dvh;
            z-index: 10000;
            background-color: #0a0a0f;
            overflow: hidden;
        }

        #web-loader .splash-picture {
            position: absolute;
            inset: 0;
            display: block;
        }

        #web-loader .splash-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            pointer-events: none;
        }

        #web-loader .loader-bar-wrap {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: min(42vw, 480px);
            aspect-ratio: 2064 / 512;
            bottom: max(7vh, 32px);
            pointer-events: none;
            overflow: visible;
        }

        #web-loader .loader-bar-wrap .loader-text {
            top: calc(50% + 2px);
            left: 50%;
            z-index: 2;
        }

        #web-loader .loader-bar-empty {
            display: block;
            width: 100%;
            height: 100%;
        }

        #web-loader .loader-bar-fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 0%;
            overflow: hidden;
            will-change: width;
        }

        #web-loader .loader-bar-full {
            display: block;
            height: 100%;
            width: auto;
            max-width: none;
        }

        #web-loader .loader-text {
            position: absolute;
            left: 50%;
            transform: translate(-50%, -50%);
            margin: 0;
            font-family: "Work Sans", system-ui, sans-serif;
            font-size: 10px;
            font-weight: 600;
            color: #fff;
            text-shadow:
                0 2px 0 #000,
                -1px -1px 0 #000,
                1px -1px 0 #000,
                -1px 1px 0 #000,
                1px 1px 0 #000;
            white-space: nowrap;
            pointer-events: none;
        }

        /* Fallback sizes before JS layout(); JS sets data-layout + inline font-size. */
        @media (max-width: 599px) and (orientation: portrait) {
            #web-loader .loader-bar-wrap {
                width: min(76vw, calc(100vw - 64px));
                bottom: max(6vh, 24px);
            }

            #web-loader .loader-text {
                font-size: 12px;
            }
        }

        @media (max-width: 599px) and (orientation: landscape) {
            #web-loader .loader-text {
                font-size: 10px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            #web-loader {
                transition: none;
            }
        }
    </style>
    <style id="sow-menu-style">
        /* __INLINE_MAIN_MENU_CSS__ */
    </style>
</head>
<body>
    <div id="web-loader" aria-live="polite" aria-busy="true">
        <picture class="splash-picture">
            <source media="(max-width: 599px)" srcset="__SOW_SPLASH_MOBILE_DATA__">
            <img id="splash-bg" class="splash-bg" alt="" decoding="sync" fetchpriority="high"
                src="__SOW_SPLASH_DESKTOP_DATA__">
        </picture>
        <div id="loader-bar-wrap" class="loader-bar-wrap">
            <img id="loader-bar-empty" class="loader-bar-empty" alt="" decoding="async" fetchpriority="high"
                src="__ASSETS_UI_BASE__loader_empty.webp?v=__BUILD_TS__">
            <div id="loader-bar-fill" class="loader-bar-fill">
                <img id="loader-bar-full" class="loader-bar-full" alt="" decoding="async" fetchpriority="low"
                    src="__ASSETS_UI_BASE__loader_full.webp?v=__BUILD_TS__">
            </div>
            <p id="loader-text" class="loader-text">Loading...</p>
        </div>
    </div>

    <!-- Portal store listings (Poki, CrazyGames, etc.) may scrape index.html for title/description. -->
    <div style="display: none;" aria-hidden="true">
        <h1>Shadows of War</h1>
        <p>Shadows of War is a match-based MMORTS on world maps. Join matchmaking, command one of twelve historical leaders, forge alliances, betray rivals, expand territory, and build your war economy.</p>
    </div>
    <canvas id="blade" oncontextmenu="return false;" tabindex="0"></canvas>
    <div id="sow-menu" hidden aria-live="polite"></div>
    <div id="sow-hud" hidden aria-live="polite"></div>
    <div id="version">v__VERSION__</div>

    <script type="text/javascript">
        window.SOW_BUILD_TS = "__BUILD_TS__";
        window.SOW_BUILD_VERSION = "__VERSION__";
        window.SOW_MAPS_CACHE_BUST = "__MAPS_CACHE_BUST__";
        /* All endpoints (SOW_WS_URL / SOW_MAPS_URL / SOW_ASSETS_URL /
           SOW_DATABASE_URL) are injected strictly by sow-dist at the
           PORTAL_BOOT_SLOT line below. No defaults and no hostname/referrer
           sniffing: a missing endpoint panics the client instead of
           misrouting (a guessed /api once hit the CrazyGames CDN). */
        /* PORTAL_BOOT_SLOT: SOW_PORTAL / SOW_WS_URL overrides injected by sow-dist crazygames. */
        window.SOW_REVENUECAT_WEB_PURCHASE_LINK = __REVENUECAT_WEB_PURCHASE_LINK__;

    </script>
    <script type="text/javascript">
        /* Crash watchdog: a wasm panic (panic=abort) traps every frame and the
           rAF loop keeps re-entering the poisoned state, freezing the game
           forever while the relay stays healthy. Detect the error storm, keep
           the panic line, and reload once so the auto-reconnect rejoins the
           match instead of leaving a dead tab. */
        (function () {
            var RELOADS_KEY = "SOW_CRASH_RELOADS";
            var PANIC_KEY = "SOW_LAST_PANIC";
            var reloads = 0;
            try { reloads = parseInt(sessionStorage.getItem(RELOADS_KEY) || "0", 10) || 0; } catch (e) {}
            try {
                var prev = sessionStorage.getItem(PANIC_KEY);
                if (prev) {
                    console.warn("[SOW watchdog] previous page crashed; captured panic:", prev);
                }
            } catch (e) {}
            var t0 = Date.now();
            var errs = [];
            window.addEventListener("error", function (ev) {
                errs.push(Date.now());
                if (errs.length > 20) { errs.shift(); }
                var cutoff = Date.now() - 5000;
                var recent = 0;
                for (var i = errs.length - 1; i >= 0 && errs[i] >= cutoff; i--) { recent++; }
                if (recent >= 8 && Date.now() - t0 > 8000 && reloads < 2) {
                    try {
                        sessionStorage.setItem(RELOADS_KEY, String(reloads + 1));
                    } catch (e) {}
                    window.location.reload();
                }
            });
            var origError = console.error;
            console.error = function () {
                for (var i = 0; i < arguments.length; i++) {
                    var a = arguments[i];
                    if (typeof a === "string" && a.indexOf("panicked at") !== -1) {
                        try { sessionStorage.setItem(PANIC_KEY, a); } catch (e) {}
                    }
                }
                return origError.apply(console, arguments);
            };
            setTimeout(function () {
                try { sessionStorage.removeItem(RELOADS_KEY); } catch (e) {}
            }, 600000);
        })();
    </script>
    <script src="./sdk/store_portals.js"></script>
    <script>/* __INLINE_LOADER_JS__ */</script>
    <script>/* __INLINE_MAIN_MENU_JS__ */</script>
    <script type="module">
        async function run() {
            var isPortal = window.SOW_RUNTIME && window.SOW_RUNTIME.portal_embed === true
                || window.SOW_isPortalEmbed === true;

            if (typeof window.SOW_initAndroidAuth === "function") {
                try {
                    await window.SOW_initAndroidAuth();
                } catch (error) {
                    console.error("Play Games authentication failed:", error);
                    // Authentication is best-effort on Android. A failed
                    // handoff must not turn into a black screen; the native
                    // client can continue with its anonymous account.
                    window.SOW_PLATFORM_IDENTITY = null;
                }
            }

            if (typeof window.SOW_initPortalSdk === "function") {
                await window.SOW_initPortalSdk();
            }
            if (typeof window.SOW_portalLoadStart === "function") {
                window.SOW_portalLoadStart();
            }

            if ('serviceWorker' in navigator
                && window.location.hostname !== "appassets.androidplatform.net"
                && !isPortal) {
                navigator.serviceWorker.register('/sw.js', { scope: './' }).catch(function (err) {
                    console.warn('Service worker registration failed:', err);
                });
            }

            try {
                const wasm = await import('./__JS_FILE__');
                await wasm.default({ module_or_path: './__WASM_FILE__' });
                if (typeof wasm.sow_menu_command === "function") {
                    window.SOW_menu_command = wasm.sow_menu_command;
                    window.SOW_MENU_READY = true;
                    if (typeof window.SOW_flush_menu_commands === "function") {
                        window.SOW_flush_menu_commands();
                    }
                }
            } catch (e) {
                if (e.message !== "Using exceptions for control flow, don't mind me. This isn't actually an error!") {
                    throw e;
                }
            }
        }

        run();
    </script>
</body>
</html>
