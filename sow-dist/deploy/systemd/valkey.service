[Unit]
Description=Valkey (Redis-compatible) for Shadows of War
After=network.target

[Service]
Type=simple
User=valkey
Group=valkey
WorkingDirectory=/var/lib/valkey
ExecStart=/usr/bin/valkey-server --port 6379 --bind 127.0.0.1 --save "" --stop-writes-on-bgsave-error no
Restart=always

[Install]
WantedBy=multi-user.target
