[Unit]
Description=Shadows of War Database Microservice (production)
After=network.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__HOME_PROD__
ExecStart=__HOME_PROD__/sow-database
Restart=always
RestartSec=3
KillMode=process
Environment=RUST_LOG=info
Environment=SOW_DB_PORT=__SOW_PROD_DB_PORT__
Environment=SOW_VALKEY_URL=redis://127.0.0.1:6379
Environment=SOW_DB_SECRET=__SOW_DB_SECRET__
Environment=CRAZYGAMES_API_KEY=__SOW_CG_API_KEY__

[Install]
WantedBy=multi-user.target
