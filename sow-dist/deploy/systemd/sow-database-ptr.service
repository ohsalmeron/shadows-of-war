[Unit]
Description=Shadows of War Database Microservice (PTR)
After=network.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__HOME_PTR__
ExecStart=__HOME_PTR__/sow-database
Restart=always
RestartSec=3
KillMode=process
Environment=RUST_LOG=info
EnvironmentFile=-/etc/default/shadowsofwar-ptr
Environment=SOW_DB_PORT=__SOW_PTR_DB_PORT__
Environment=SOW_VALKEY_URL=redis://127.0.0.1:6379

[Install]
WantedBy=multi-user.target
