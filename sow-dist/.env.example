# ./sow p defaults. Copy to sow-dist/.env, fill with your values.
# This is CONFIG (not secret) — hosts, ports, toggles. No credentials live here.
# The real secret (Cloudflare API token for DNS-01 cert issuance) lives in a
# password vault, NOT in this repo.
# SOW_DB_SECRET must be supplied only in ignored sow-dist/.env (mode 0600).

# --- Build / deploy topology --------------------------------------------------

# SSH alias for the FreeBSD builder (compiles sow-server + sow-database).
SOW_FREEBSD_BUILDER_HOST=freebsd
# Where the project lives on that VM.
SOW_FREEBSD_BUILDER_ROOT=/home/bizkit/shadows-of-war

# SSH alias for the control host (sow-server, sow-database, nginx, valkey).
SOW_CONTROL_HOST=ionos
# Staging directory where releases hang out before activation.
SOW_REMOTE_STAGE=/home/bizkit/.sow-deploy

# Public origin URL. The game client will try to fetch assets from here.
SOW_PUBLIC_ORIGIN=https://shadowsofwar.io

# WOU-ID bearer validation endpoint used when a player signs in with WOU.
WOU_ID_URL=https://id.worldofunreal.com
# The SOW database jail has no resolver; preserve hostname/SNI and pin HTTPS
# to a Cloudflare edge (the current IONOS origin certificate is not valid for
# id.worldofunreal.com).
WOU_ID_RESOLVE_IP=104.21.87.220

# Play Games Services v2. Android debug/release app ID and server OAuth client.
# The client secret is required only in the ignored sow-dist/.env and production
# sow.env; never commit it or expose it to Android/Web.
# SOW_PLAY_GAMES_APP_ID=000000000000
# SOW_PLAY_GAMES_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# SOW_PLAY_GAMES_WEB_CLIENT_SECRET=replace-with-secret
# SOW_PLAY_GAMES_AUTH_URL=https://shadowsofwar.io/api
# Public Play Games event ID incremented after each completed Android match.
# SOW_PLAY_GAMES_MATCH_EVENT_ID=...
# Draft achievement unlocked after an Android player wins their first match.
# SOW_PLAY_GAMES_FIRST_VICTORY_ACHIEVEMENT_ID=...
# Draft incremental achievement advanced after each verified match.
# SOW_PLAY_GAMES_BATTLE_HARDENED_ACHIEVEMENT_ID=...
# Draft incremental achievement advanced after each verified victory.
# SOW_PLAY_GAMES_VICTORY_MARCH_ACHIEVEMENT_ID=...
# Draft incremental achievement advanced by laurels earned from each match.
# SOW_PLAY_GAMES_LAUREL_HOARD_ACHIEVEMENT_ID=...
# Draft leader milestones, evaluated from authoritative profile leader stats.
# SOW_PLAY_GAMES_FIRST_COMMAND_ACHIEVEMENT_ID=...
# SOW_PLAY_GAMES_COMMANDER_VICTORIOUS_ACHIEVEMENT_ID=...
# SOW_PLAY_GAMES_VETERAN_COMMANDER_ACHIEVEMENT_ID=...
# SOW_PLAY_GAMES_BANNER_COLLECTOR_ACHIEVEMENT_ID=...
# Draft incremental achievement advanced after each leader-backed match.
# SOW_PLAY_GAMES_LEADER_PATH_ACHIEVEMENT_ID=...
# Draft all-time leaderboard receiving the player's cumulative victories.
# SOW_PLAY_GAMES_VICTORIES_LEADERBOARD_ID=...

# Global orchestrator WebSocket admission cap. The server rejects new TCP
# peers before spawning another connection task once this is reached.
SOW_SERVER_MAX_CONNECTIONS=32768

# Set to 1 after your DNS game is strong and public verification passes.
SOW_REQUIRE_PUBLIC=1

# Production RevenueCat Web Purchase Link. This is public configuration, not a secret.
SOW_REVENUECAT_WEB_PURCHASE_LINK=https://pay.rev.cat/replace-with-production-token

# --- Moderation email (optional, graceful when unset) ---------------------------
# Player reports are always stored server-side and logged. When these are set
# (in the PRODUCTION sow.env on IONOS, mode 0600 — never in this repo), each
# report is also emailed to the moderation mailbox via the Stalwart SMTP relay.
# Leave unset and the game keeps working; reports queue in sow:reports:index.
# SOW_SMTP_HOST=mail.worldofunreal.com
# SOW_SMTP_PORT=587
# SOW_SMTP_USER=no-reply@shadowsofwar.io
# SOW_SMTP_PASS=
# SOW_SMTP_FROM=no-reply@shadowsofwar.io
# SOW_MODERATION_EMAIL=

# --- F-Stack relay catalog ----------------------------------------------------
# ./sow p deploys the relay binary (built on the Azure host from repo sources)
# and verifies it every run. These values are relay runtime configuration.

# WS write timeout (ms) stamped into the relay unit drop-in, the [BOOT] line
# and the relay manifest. 15000 = repo truth; tuning it re-deploys the relay.
SOW_WS_WRITE_TIMEOUT_MS=15000
# Relay build host layout (source of truth is always the repo; these are the
# rsync destinations on the Azure VM).
# SOW_RELAY_DEPLOY_HOST=relay
# SOW_RELAY_ROOT=/home/azureuser/shadows-of-war
# SOW_FSTACK_REPO=/home/bizkit/Github/infra/f-stack

# Advertised relay address. MUST be the TLS hostname (cert is issued for it),
# NOT the raw IP — browsers validate the cert against this name.
SOW_RELAY_HOST=relay.shadowsofwar.io

# Number of F-Stack worker processes. Must equal lcore_mask popcount in
# fstack-bridge/echo-vf.ini (lcore_mask=f = 4).
SOW_RELAY_WORKER_COUNT=4

# Relay-to-database endpoint. Use the IONOS HTTPS origin; the relay is not a
# datastore and should not send its bearer over raw HTTP to the public IP.
SOW_DB_URL=https://shadowsofwar.io
# Pin the relay's HTTPS connection to IONOS while retaining the hostname for
# certificate/SNI validation. This bypasses the public Cloudflare edge.
SOW_DB_RESOLVE_IP=74.208.246.177
# Source address allowed through IONOS nginx for relay database mutations.
SOW_RELAY_DB_SOURCE_IP=20.230.49.9

# Management API of worker 0 (kernel HTTP, used for lobby registration).
SOW_RELAY_MGMT_URL=https://relay.shadowsofwar.io:8080
SOW_RELAY_MGMT_SCHEME=https
SOW_RELAY_TICKETS_REQUIRED=1
# Per-worker relay admission. The filter runs immediately after F-Stack
# accept, before TLS/WebSocket parsing. Keep these explicit for reproducible
# capacity changes; values are deliberately high enough for normal NAT pools.
SOW_RELAY_MAX_CONNECTIONS=32768
SOW_RELAY_MAX_CONNECTIONS_PER_IP=4096
SOW_RELAY_HANDSHAKES_PER_IP=512
# Management TLS hostname stays relay.shadowsofwar.io; this pins IONOS's
# management requests to the relay management NIC instead of the game NIC.
SOW_RELAY_MGMT_RESOLVE_IP=20.230.49.9

# Worker catalog, one entry per worker:
#   <game_host>:<mgmt_host>:<mgmt_port>
# game_host  = what the client connects to (TLS hostname, same as SOW_RELAY_HOST)
# mgmt_host  = kernel mgmt IP, used by sow-server for POST /internal/lobby/register
SOW_RELAY_WORKERS=relay.shadowsofwar.io:relay.shadowsofwar.io:8080,relay.shadowsofwar.io:relay.shadowsofwar.io:8081,relay.shadowsofwar.io:relay.shadowsofwar.io:8082,relay.shadowsofwar.io:relay.shadowsofwar.io:8083

# Local paths of the relay TLS cert for the separate relay lifecycle. The
# current production pipeline does not copy or restart relay TLS material.
# If these files are missing the relay boots WITHOUT TLS (plain ws://) — the
# client handoff expects wss://, so production breaks. Regenerate with:
#   certbot certonly --dns-cloudflare --dns-cloudflare-credentials <cf.ini> \
#     -d relay.shadowsofwar.io
SOW_RELAY_TLS_CERT_LOCAL=/etc/letsencrypt/live/relay.shadowsofwar.io/fullchain.pem
SOW_RELAY_TLS_KEY_LOCAL=/etc/letsencrypt/live/relay.shadowsofwar.io/privkey.pem
