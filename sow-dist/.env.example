# ./sow p defaults. Copy to sow-dist/.env, fill with your secrets, and
# pretend you're a 1337 h4x0r. Or just use the defaults and watch it fail
# spectacularly. Your call.

# SSH alias for the FreeBSD build VM (your pet server in the closet).
# SOW_BUILD_HOST=freebsd
# Where the project lives on that VM.
# SOW_BUILD_ROOT=/home/your-username/shadows-of-war

# SSH alias for the production FreeBSD VM (the one you don't tell your boss about).
# SOW_PROD_HOST=sow
# Staging directory where releases hang out before activation.
# SOW_REMOTE_STAGE=/home/your-username/.sow-deploy

# Public origin URL. The game client will try to fetch assets from here.
# Use https. We're not savages.
# SOW_PUBLIC_ORIGIN=https://your-cool-domain.example.com

# Comma-separated SSH aliases for backfill bot hosts.
# SOW_BACKFILL_HOSTS=your-backfill-bot-net

# Backfill staging directory.
# SOW_BACKFILL_STAGE=/home/your-username/.sow-backfill

# Set to 1 after your DNS game is strong and public verification passes.
# SOW_REQUIRE_PUBLIC=0
