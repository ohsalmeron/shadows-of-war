# Optional overrides — copy to .env only when you need non-default values (never commit .env).
# ./sow local needs no .env (uses public prod wss/CDN URLs from the repo).
# Remote deploy: `gcloud auth login` + IAP tunnel + tar (no rsync). Not stored here.

# --- GCP (./sow cg | p | ptr | infra) ---
# Project: SOW_GCP_PROJECT env, else `gcloud config get-value project`.
# SOW_GCP_PROJECT=your-gcp-project-id
# SOW_GCP_ZONE=us-central1-a
# SOW_GCP_INSTANCE=sow-server
# Reserved static IP address *name* in GCP (not the numeric IP)
# SOW_GCP_STATIC_IP=sow-server-ip

# --- GCP optional cleanup on ./sow infra --confirm-destroy (leave empty to skip) ---
# SOW_GCP_TEST_INSTANCE=
# SOW_GCP_TEST_ZONE=
# SOW_GCP_TEST_STATIC_IP=
# SOW_GCP_TEST_STATIC_IP_REGION=

# --- Public site origins (defaults: shadowsofwar.io — forks: override) ---
# SOW_SITE_ORIGIN=https://shadowsofwar.io
# SOW_PLAY_ORIGIN=https://play.shadowsofwar.io
# SOW_PTR_ORIGIN=https://ptr.shadowsofwar.io

# --- TLS (certbot) — required when ./sow p|ptr pushes sow-dist/deploy/ nginx changes; always for ./sow infra ---
# SOW_CERTBOT_EMAIL=admin@yourdomain.com

# --- Optional remote path overrides (defaults: $HOME/shadowsofwar on VPS) ---
# SOW_REMOTE_DATA_PROD=
# SOW_REMOTE_DATA_PTR=
# SOW_REMOTE_MAPS_PROD=
# SOW_REMOTE_MAPS_PTR=

# --- Optional local build ---
# CARGO_TARGET_DIR=dist/.cargo-target

# --- Never put secrets here ---
# Server-only (set on VPS systemd / environment, not in this file):
#   SOW_DB_SECRET, CRAZYGAMES_API_KEY
